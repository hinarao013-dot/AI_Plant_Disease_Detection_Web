generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model PlantCatalog {
  id             Int       @id @default(autoincrement())
  commonName     String
  scientificName String    @unique
  oxygenSupport  String?
  advantages     String?
  disadvantages  String?
  humanBenefits  String?
}

model ScanHistory {
  id          Int      @id @default(autoincrement())
  plantName   String
  sciName     String?
  disease     String
  solution    String
  date        DateTime @default(now())
  imageUrl    String?  // Can store base64 string or an image path
}
